{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BrowserSync",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/src",
            "runtimeExecutable": "/snap/bin/brave",
            "runtimeArgs": [
                "--remote-debugging-port=9222",
                "--new-window",
                "--user-data-dir=/tmp/brave-debug"
            ],
            "windows": {
                "runtimeExecutable": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
                "runtimeArgs": [
                    "--remote-debugging-port=9222",
                    "--new-window",
                    "--user-data-dir=${env:TEMP}\\brave-debug"
                ]
            },
            "preLaunchTask": "Lanzar browser-sync",
            "postDebugTask": "Apagar browser-sync"
        },
        {
            "name": "browser-sync debug",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000/test/runner.html",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "/snap/bin/brave",
            "runtimeArgs": [
                "--remote-debugging-port=9222",
                "--new-window",
                "--user-data-dir=/tmp/brave-debug"
            ],
            "windows": {
                "runtimeExecutable": "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe",
                "runtimeArgs": [
                    "--remote-debugging-port=9222",
                    "--new-window",
                    "--user-data-dir=${env:TEMP}\\brave-debug"
                ]
            },
            "preLaunchTask": "debug browser",
            "postDebugTask": "Apagar browser-sync"
        }
    ]
}
